{
  "name": "todo-app-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js web interface for the To-Do App. Reads tasks with Prisma; writes go through the Express API.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prisma:generate": "prisma generate",
    "predev": "npm run prisma:generate",
    "dev": "next dev",
    "prebuild": "npm run prisma:generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "pretypecheck": "npm run prisma:generate",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.9",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "unrs-resolver": false
  }
}
