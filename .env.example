# Template for the environment variables used by the whole project.
# Copy it to `.env` (`cp .env.example .env`) and adjust the values;
# `.env` is ignored by Git, so real credentials never get committed.

# `docker compose up` works without this file: docker-compose.yml has a default
# for every variable and builds its own in-network URLs (see docs/docker.md).

# --- PostgreSQL container (docker-compose.yml) ---
POSTGRES_USER=todo
POSTGRES_PASSWORD=todo
POSTGRES_DB=todo
POSTGRES_PORT=5432

# --- Database connection ---
# Used by Prisma (schema migrations and reads from Next.js)
# and by the Express connection pool (all writes).
DATABASE_URL=postgresql://todo:todo@localhost:5432/todo
# Separate database for the backend tests (`npm test`), in the same container.
# The test setup creates and migrates it; it must differ from DATABASE_URL.
TEST_DATABASE_URL=postgresql://todo:todo@localhost:5432/todo_test

# --- Express API ---
API_PORT=4000
# Connection pool (optional; defaults shown). See docs/api.md.
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# --- Next.js ---
# Host port of the web app when it runs in docker compose.
FRONTEND_PORT=3000
# Base URL the Next.js route handlers use to forward writes to Express.
# Server-side only: it is not exposed to the browser.
BACKEND_URL=http://localhost:4000
